{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@mason/types": ["types/mason/index.d.ts"] }
  },
  "include": ["test/masonfile-examples/**/*.ts", "types/mason/index.d.ts"]
}
